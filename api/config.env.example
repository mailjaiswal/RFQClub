# Copy to config.env and fill real values. NEVER commit config.env.
# --- Telegram ingestion bot ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat/group IDs allowed to submit RFQs
ALLOWED_CHAT_IDS=
# Comma-separated chat IDs allowed to run /approve /reject (operators)
OPERATOR_CHAT_IDS=

# --- Optional LLM-assist for messy-text structuring (can stay off) ---
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- API ---
DATABASE_URL=sqlite:///./data.db
CORS_ORIGINS=http://localhost:3000

# --- Inside-sales console (DB-managed access) ---
# Access is now granted from the console's Team & access panel, NOT from these
# lists. SALES_EMAILS / SALES_MANAGER_EMAILS are legacy and no longer consulted
# by require_sales; they are kept only as an optional seed hint and can be left empty.
SALES_EMAILS=
SALES_MANAGER_EMAILS=
# First inside-sales manager, auto-seeded once on startup (idempotent). Access is
# thereafter DB-managed from the console Team panel. The account is flagged
# must-change-password, so this temporary password is rotated on first sign-in.
SALES_ADMIN_EMAIL=mail.jaiswal@gmail.com
SALES_ADMIN_PASSWORD=Welcome@123
